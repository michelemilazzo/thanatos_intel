{
  "doctype": "DocType",
  "name": "Crypto Scam Intelligence",
  "module": "Thanatos Cyber",
  "autoname": "format:THAN-CRYPTO-{YYYY}-{#####}",
  "title_field": "title",
  "track_changes": 1,
  "fields": [
    {"fieldname": "title", "fieldtype": "Data", "label": "Title", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "source", "fieldtype": "Data", "label": "Source", "default": "Chainalysis", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "source_url", "fieldtype": "Data", "label": "Source URL"},
    {"fieldname": "published_on", "fieldtype": "Date", "label": "Published On", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "col_1", "fieldtype": "Column Break"},
    {"fieldname": "scam_type", "fieldtype": "Select", "label": "Scam Type",
      "options": "Phishing\nRug Pull\nRomance Scam\nInvestment Scam\nPig Butchering\nFake Exchange\nSIM Swap\nPonzi\nAirdrop Scam\nNFT Scam\nMixer Abuse\nOther",
      "in_list_view": 1, "in_standard_filter": 1, "reqd": 1},
    {"fieldname": "risk_level", "fieldtype": "Select", "label": "Risk Level",
      "options": "Low\nMedium\nHigh\nCritical", "default": "Medium", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "language", "fieldtype": "Select", "label": "Language",
      "options": "en\nit\nro\nbg", "default": "en"},
    {"fieldname": "sb_summary", "fieldtype": "Section Break", "label": "Summary"},
    {"fieldname": "summary", "fieldtype": "Text Editor", "label": "Thanatos Summary (rewritten)"},
    {"fieldname": "key_metrics", "fieldtype": "Long Text", "label": "Key Metrics (JSON)"},
    {"fieldname": "sb_intel", "fieldtype": "Section Break", "label": "Intelligence"},
    {"fieldname": "wallets_observed", "fieldtype": "Long Text", "label": "Wallets Observed (one per line)"},
    {"fieldname": "chains", "fieldtype": "Data", "label": "Chains (comma sep: BTC,ETH,TRX,BSC,SOL)"},
    {"fieldname": "estimated_loss_usd", "fieldtype": "Currency", "label": "Estimated Loss (USD)", "options": "USD"},
    {"fieldname": "victims_count", "fieldtype": "Int", "label": "Victims Count"},
    {"fieldname": "col_2", "fieldtype": "Column Break"},
    {"fieldname": "geography", "fieldtype": "Data", "label": "Geography (ISO codes)"},
    {"fieldname": "modus_operandi", "fieldtype": "Text", "label": "Modus Operandi"},
    {"fieldname": "indicators", "fieldtype": "Text", "label": "Indicators / Red Flags"},
    {"fieldname": "mitigation", "fieldtype": "Text", "label": "Recommended Mitigation"},
    {"fieldname": "sb_links", "fieldtype": "Section Break", "label": "Investigation Links"},
    {"fieldname": "investigation_case", "fieldtype": "Link", "label": "Related Case", "options": "Investigation Case"},
    {"fieldname": "related_iocs", "fieldtype": "Long Text", "label": "Related IOCs"},
    {"fieldname": "sb_raw", "fieldtype": "Section Break", "label": "Raw Source"},
    {"fieldname": "raw_html", "fieldtype": "Code", "label": "Raw HTML excerpt", "options": "HTML"},
    {"fieldname": "raw_hash", "fieldtype": "Data", "label": "SHA-256 source hash"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status",
      "options": "Draft\nReviewed\nPublished\nArchived", "default": "Draft", "in_list_view": 1, "in_standard_filter": 1}
  ],
  "permissions": [
    {"role": "Investigation Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 0},
    {"role": "Investigator", "read": 1, "write": 1, "create": 1},
    {"role": "Analyst", "read": 1, "write": 1, "create": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
