{
  "doctype": "DocType",
  "name": "File Sample",
  "module": "Thanatos Cyber",
  "autoname": "format:FSAM-{YYYY}-{#####}",
  "title_field": "file_name",
  "fields": [
    {"fieldname": "file_name", "fieldtype": "Data", "label": "File Name", "in_list_view": 1, "reqd": 1},
    {"fieldname": "file_url", "fieldtype": "Attach", "label": "File"},
    {"fieldname": "file_size", "fieldtype": "Int", "label": "Size (bytes)"},
    {"fieldname": "mime_type", "fieldtype": "Data", "label": "MIME"},
    {"fieldname": "col_1", "fieldtype": "Column Break"},
    {"fieldname": "sha256", "fieldtype": "Data", "label": "SHA-256", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "sha1", "fieldtype": "Data", "label": "SHA-1"},
    {"fieldname": "md5", "fieldtype": "Data", "label": "MD5"},
    {"fieldname": "sb_classification", "fieldtype": "Section Break", "label": "Classification"},
    {"fieldname": "verdict", "fieldtype": "Select", "label": "Verdict", "options": "\nClean\nSuspicious\nMalicious\nPUA\nUnknown", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "malware_family", "fieldtype": "Data", "label": "Malware Family"},
    {"fieldname": "col_class", "fieldtype": "Column Break"},
    {"fieldname": "first_seen", "fieldtype": "Datetime", "label": "First Seen"},
    {"fieldname": "vt_malicious", "fieldtype": "Int", "label": "VT Malicious"},
    {"fieldname": "vt_total", "fieldtype": "Int", "label": "VT Total"},
    {"fieldname": "sb_links", "fieldtype": "Section Break", "label": "Links"},
    {"fieldname": "investigation_case", "fieldtype": "Link", "label": "Investigation Case", "options": "Investigation Case"},
    {"fieldname": "evidence", "fieldtype": "Link", "label": "Evidence", "options": "Investigation Evidence"},
    {"fieldname": "entity", "fieldtype": "Link", "label": "Entity", "options": "Entity"}
  ],
  "permissions": [
    {"role": "Investigation Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Investigator", "read": 1, "write": 1, "create": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
