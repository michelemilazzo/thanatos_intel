{
  "doctype": "DocType",
  "name": "Document Verdict",
  "module": "Thanatos Documents",
  "autoname": "format:DVER-{YYYY}-{#####}",
  "title_field": "title",
  "fields": [
    {"fieldname": "title", "fieldtype": "Data", "label": "Title", "in_list_view": 1},
    {"fieldname": "document_intake", "fieldtype": "Link", "label": "Document", "options": "Document Intake", "reqd": 1, "in_list_view": 1},
    {"fieldname": "overall_verdict", "fieldtype": "Select", "label": "Verdict", "options": "Authentic\nLikely Authentic\nInconclusive\nSuspicious\nForged", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "risk_score", "fieldtype": "Int", "label": "Risk", "in_list_view": 1},
    {"fieldname": "col_1", "fieldtype": "Column Break"},
    {"fieldname": "analyst", "fieldtype": "Link", "label": "Analyst", "options": "User"},
    {"fieldname": "reviewer", "fieldtype": "Link", "label": "Reviewer", "options": "User"},
    {"fieldname": "issued_at", "fieldtype": "Datetime", "label": "Issued"},
    {"fieldname": "signed", "fieldtype": "Check", "label": "Signed", "in_list_view": 1},
    {"fieldname": "sb", "fieldtype": "Section Break", "label": "Reasoning"},
    {"fieldname": "rationale", "fieldtype": "Text Editor", "label": "Rationale"},
    {"fieldname": "limitations", "fieldtype": "Small Text", "label": "Limitations"}
  ],
  "permissions": [
    {"role": "Investigation Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Investigator", "read": 1, "write": 1, "create": 1},
    {"role": "Lawyer", "read": 1},
    {"role": "Investigation Client", "read": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
