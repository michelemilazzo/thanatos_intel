  {"fieldname":"sb_erp","fieldtype":"Section Break","label":"ERPNext","collapsible":1},
  {"fieldname":"erp_item_code","fieldtype":"Data","label":"ERP Item Code"},
  {"fieldname":"sb_desc","fieldtype":"Section Break","label":"Description"},
  {"fieldname":"description","fieldtype":"Text Editor","label":"Description"}
