  {"fieldname":"max_users","fieldtype":"Int","label":"Max Users"},
  {"fieldname":"sb_features","fieldtype":"Section Break","label":"Features"},
  {"fieldname":"has_client_portal","fieldtype":"Check","label":"Client Portal","default":1},
