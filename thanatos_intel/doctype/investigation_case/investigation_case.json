{
  "name": "Investigation Case",
  "doctype": "DocType",
  "module": "Thanatos Intel",
  "autoname": "field:case_code",
  "is_submittable": false,
  "fields": [
    {"fieldname": "case_code", "fieldtype": "Data", "label": "Case Code", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "title", "fieldtype": "Data", "label": "Title", "reqd": 1, "in_list_view": 1},
    {"fieldname": "customer", "fieldtype": "Link", "label": "Customer", "options": "Customer"},
    {"fieldname": "case_type", "fieldtype": "Select", "label": "Case Type", "options": "OSINT\nFraud\nCyber\nCorporate\nLegal"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Open\nIn Progress\nClosed", "default": "Open", "in_list_view": 1},
    {"fieldname": "priority", "fieldtype": "Select", "label": "Priority", "options": "Low\nMedium\nHigh\nCritical", "default": "Medium", "in_list_view": 1},
    {"fieldname": "description", "fieldtype": "Text Editor", "label": "Description"},
    {"fieldname": "assigned_investigator", "fieldtype": "Link", "label": "Assigned To", "options": "User"},
    {"fieldname": "risk_score", "fieldtype": "Int", "label": "Risk Score"},
    {"fieldname": "final_decision", "fieldtype": "Small Text", "label": "Final Decision"},
    {"fieldname": "final_report", "fieldtype": "Text Editor", "label": "Final Report"},
    {"fieldname": "opening_date", "fieldtype": "Date", "label": "Opening Date"},
    {"fieldname": "closing_date", "fieldtype": "Date", "label": "Closing Date"}
  ]
}