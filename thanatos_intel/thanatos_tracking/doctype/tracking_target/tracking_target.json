{
  "doctype": "DocType",
  "name": "Tracking Target",
  "module": "Thanatos Tracking",
  "autoname": "format:TGT-{YYYY}-{#####}",
  "title_field": "target_name",
  "image_field": "photo",
  "track_changes": 1,
  "search_fields": "target_name,aliases,source_ref,nationality",
  "fields": [
    {"fieldname": "target_name", "fieldtype": "Data", "label": "Name", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "classification", "fieldtype": "Select", "label": "Classification", "options": "Public Wanted\nClient Case\nInternal", "default": "Internal", "in_list_view": 1, "in_standard_filter": 1, "reqd": 1},
    {"fieldname": "target_type", "fieldtype": "Select", "label": "Type", "options": "Person\nOrganization\nVessel\nAircraft\nAsset", "default": "Person", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "col_1", "fieldtype": "Column Break"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Active\nLocated\nApprehended\nCold\nClosed", "default": "Active", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "priority", "fieldtype": "Select", "label": "Priority", "options": "Low\nMedium\nHigh\nCritical", "default": "Medium", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "photo", "fieldtype": "Attach Image", "label": "Photo"},
    {"fieldname": "sb_identity", "fieldtype": "Section Break", "label": "Identity"},
    {"fieldname": "aliases", "fieldtype": "Small Text", "label": "Aliases / AKA"},
    {"fieldname": "date_of_birth", "fieldtype": "Date", "label": "Date of Birth"},
    {"fieldname": "nationality", "fieldtype": "Data", "label": "Nationality"},
    {"fieldname": "gender", "fieldtype": "Data", "label": "Gender"},
    {"fieldname": "ethnicity", "fieldtype": "Data", "label": "Ethnicity"},
    {"fieldname": "col_2", "fieldtype": "Column Break"},
    {"fieldname": "last_known_location", "fieldtype": "Data", "label": "Last Known Location / Birthplace"},
    {"fieldname": "wanted_for", "fieldtype": "Small Text", "label": "Wanted For / Charges"},
    {"fieldname": "reward", "fieldtype": "Data", "label": "Reward"},
    {"fieldname": "sb_physical", "fieldtype": "Section Break", "label": "Physical Profile", "collapsible": 1},
    {"fieldname": "height", "fieldtype": "Data", "label": "Height"},
    {"fieldname": "weight", "fieldtype": "Data", "label": "Weight"},
    {"fieldname": "eye_color", "fieldtype": "Data", "label": "Eye Color"},
    {"fieldname": "col_phys", "fieldtype": "Column Break"},
    {"fieldname": "hair_color", "fieldtype": "Data", "label": "Hair Color"},
    {"fieldname": "distinguishing_marks", "fieldtype": "Small Text", "label": "Distinguishing Marks"},
    {"fieldname": "sb_case", "fieldtype": "Section Break", "label": "Case & Source"},
    {"fieldname": "investigation_case", "fieldtype": "Link", "label": "Investigation Case", "options": "Investigation Case", "in_standard_filter": 1},
    {"fieldname": "client", "fieldtype": "Link", "label": "Client", "options": "Investigation Client"},
    {"fieldname": "col_3", "fieldtype": "Column Break"},
    {"fieldname": "source", "fieldtype": "Data", "label": "Source", "description": "Es. Interpol Red Notice, Europol EU Most Wanted, Client, Internal"},
    {"fieldname": "source_ref", "fieldtype": "Data", "label": "Source Ref / External ID", "unique": 0},
    {"fieldname": "source_url", "fieldtype": "Data", "label": "Source URL"},
    {"fieldname": "sb_desc", "fieldtype": "Section Break", "label": "Description"},
    {"fieldname": "description", "fieldtype": "Text Editor", "label": "Description"},
    {"fieldname": "sb_osint", "fieldtype": "Section Break", "label": "OSINT Enrichment", "collapsible": 1},
    {"fieldname": "risk_score", "fieldtype": "Int", "label": "Risk Score", "read_only": 1},
    {"fieldname": "last_enriched", "fieldtype": "Datetime", "label": "Last Enriched", "read_only": 1},
    {"fieldname": "col_4", "fieldtype": "Column Break"},
    {"fieldname": "lead_count", "fieldtype": "Int", "label": "Leads", "read_only": 1},
    {"fieldname": "sb_osint2", "fieldtype": "Section Break"},
    {"fieldname": "osint_summary", "fieldtype": "Small Text", "label": "OSINT Summary", "read_only": 1},
    {"fieldname": "ai_suggestions", "fieldtype": "Small Text", "label": "AI Suggested Next Steps", "read_only": 1},
    {"fieldname": "aggregated_json", "fieldtype": "Code", "label": "Aggregated JSON", "options": "JSON", "read_only": 1}
  ],
  "permissions": [
    {"role": "Investigation Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Investigator", "read": 1, "write": 1, "create": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
