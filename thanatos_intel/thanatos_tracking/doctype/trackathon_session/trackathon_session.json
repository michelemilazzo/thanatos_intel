{
  "doctype": "DocType",
  "name": "Trackathon Session",
  "module": "Thanatos Tracking",
  "autoname": "format:TRK-{YYYY}-{#####}",
  "title_field": "title",
  "track_changes": 1,
  "fields": [
    {"fieldname": "title", "fieldtype": "Data", "label": "Title", "reqd": 1, "in_list_view": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Planned\nActive\nClosed", "default": "Planned", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "col_1", "fieldtype": "Column Break"},
    {"fieldname": "start", "fieldtype": "Datetime", "label": "Start"},
    {"fieldname": "end", "fieldtype": "Datetime", "label": "End"},
    {"fieldname": "coordinator", "fieldtype": "Link", "label": "Coordinator", "options": "User"},
    {"fieldname": "sb_obj", "fieldtype": "Section Break", "label": "Objective"},
    {"fieldname": "objective", "fieldtype": "Small Text", "label": "Objective"},
    {"fieldname": "sb_targets", "fieldtype": "Section Break", "label": "Targets"},
    {"fieldname": "targets", "fieldtype": "Table", "label": "Targets", "options": "Trackathon Target Link"},
    {"fieldname": "sb_team", "fieldtype": "Section Break", "label": "Team"},
    {"fieldname": "participants", "fieldtype": "Table", "label": "Participants", "options": "Trackathon Participant"},
    {"fieldname": "sb_result", "fieldtype": "Section Break", "label": "Result"},
    {"fieldname": "leads_count", "fieldtype": "Int", "label": "Leads Collected", "read_only": 1},
    {"fieldname": "col_2", "fieldtype": "Column Break"},
    {"fieldname": "verified_leads", "fieldtype": "Int", "label": "Verified Leads", "read_only": 1},
    {"fieldname": "sb_wrap", "fieldtype": "Section Break"},
    {"fieldname": "summary", "fieldtype": "Text Editor", "label": "Wrap-up Summary"}
  ],
  "permissions": [
    {"role": "Investigation Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Investigator", "read": 1, "write": 1, "create": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
