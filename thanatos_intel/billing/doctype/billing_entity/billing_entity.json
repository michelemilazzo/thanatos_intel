{
 "doctype": "DocType",
 "name": "Billing Entity",
 "module": "Billing",
 "autoname": "field:entity_name",
 "title_field": "entity_name",
 "track_changes": 1,
 "fields": [
  {"fieldname": "entity_name", "fieldtype": "Data", "label": "Entity Name", "reqd": 1, "unique": 1, "in_list_view": 1, "description": "Nome breve identificativo (es. ARES INVESTIGAZIONI SRL)"},
  {"fieldname": "legal_name", "fieldtype": "Data", "label": "Ragione sociale", "in_list_view": 1},
  {"fieldname": "vat_number", "fieldtype": "Data", "label": "Partita IVA / VAT"},
  {"fieldname": "registration_number", "fieldtype": "Data", "label": "Numero registro / SIREN"},
  {"fieldname": "is_active", "fieldtype": "Check", "label": "Attiva", "default": "1"},
  {"fieldname": "cb_1", "fieldtype": "Column Break"},
  {"fieldname": "country", "fieldtype": "Link", "label": "Paese", "options": "Country"},
  {"fieldname": "address", "fieldtype": "Small Text", "label": "Indirizzo"},
  {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email"},
  {"fieldname": "phone", "fieldtype": "Data", "label": "Telefono"},
  {"fieldname": "sb_bank", "fieldtype": "Section Break", "label": "Coordinate bancarie"},
  {"fieldname": "bank_name", "fieldtype": "Data", "label": "Banca", "in_list_view": 1},
  {"fieldname": "account_holder", "fieldtype": "Data", "label": "Titolare"},
  {"fieldname": "iban", "fieldtype": "Data", "label": "IBAN", "in_list_view": 1},
  {"fieldname": "cb_2", "fieldtype": "Column Break"},
  {"fieldname": "bic_swift", "fieldtype": "Data", "label": "BIC / SWIFT"},
  {"fieldname": "logo", "fieldtype": "Attach Image", "label": "Logo"},
  {"fieldname": "sb_link", "fieldtype": "Section Break", "label": "Contabilità"},
  {"fieldname": "erp_company", "fieldtype": "Link", "label": "Company ERPNext (se separata)", "options": "Company", "description": "Opzionale: collega a una Company ERPNext dedicata per la contabilità separata"},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "Note"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Investigation Manager", "read": 1, "write": 1, "create": 1}
 ]
}
