{
 "doctype": "DocType",
 "name": "Blueprint Step",
 "module": "Thanatos Core",
 "istable": 1,
 "fields": [
  {
   "fieldname": "step_label",
   "fieldtype": "Data",
   "label": "Step",
   "reqd": 1,
   "in_list_view": 1,
   "columns": 3
  },
  {
   "fieldname": "actor_role",
   "fieldtype": "Link",
   "label": "Ruolo",
   "options": "Case Role",
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "mode",
   "fieldtype": "Select",
   "label": "Modo",
   "options": "AUTO\nGATE",
   "default": "AUTO",
   "in_list_view": 1,
   "columns": 1
  },
  {
   "fieldname": "action_type",
   "fieldtype": "Select",
   "label": "Azione",
   "options": "form\nsign\npay\nupload\nwork\nreview\ndeliver\nnotify\nai_question",
   "default": "work",
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "service_code",
   "fieldtype": "Link",
   "options": "Service Catalog",
   "label": "Servizio (catalogo)",
   "description": "Voce di catalogo che determina il prezzo dello step (per step 'pay')."
  },
  {
   "fieldname": "price",
   "fieldtype": "Currency",
   "label": "Prezzo step (EUR)",
