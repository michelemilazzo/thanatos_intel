  },
  {
   "fieldname": "client_visible",
   "fieldtype": "Check",
   "label": "Visibile cliente",
   "default": "1"
  },
  {
   "fieldname": "notify",
   "fieldtype": "Check",
   "label": "Notifica",
   "default": "1"
  },
  {
   "fieldname": "optional",
   "fieldtype": "Check",
   "label": "Opzionale"
  },
  {
   "fieldname": "sla_hours",
   "fieldtype": "Int",
   "label": "SLA (ore)"
  },
  {
   "fieldname": "condition",
   "fieldtype": "Data",
   "label": "Condizione (eval)",
   "description": "Se valutata falsa lo step viene saltato. Variabile: case"
  },
  {
   "fieldname": "output",
   "fieldtype": "Data",
   "label": "Output prodotto"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Descrizione"
  }
 ]
