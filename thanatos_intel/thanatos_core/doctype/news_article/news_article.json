{
 "doctype": "DocType",
 "name": "News Article",
 "module": "Thanatos Core",
 "engine": "InnoDB",
 "autoname": "format:NEWS-{YYYY}-{#####}",
 "title_field": "title",
 "search_fields": "title,slug,excerpt,tags",
 "track_changes": 1,
 "has_web_view": 1,
 "allow_guest_to_view": 1,
 "fields": [
  {"fieldname": "title", "fieldtype": "Data", "label": "Title", "reqd": 1, "in_list_view": 1, "in_global_search": 1, "length": 240},
  {"fieldname": "slug", "fieldtype": "Data", "label": "Slug", "reqd": 1, "unique": 1, "in_global_search": 1,
   "description": "URL slug. Auto-generated from title."},
  {"fieldname": "category", "fieldtype": "Link", "label": "Category", "options": "News Category", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "cb_meta1", "fieldtype": "Column Break"},
  {"fieldname": "published", "fieldtype": "Check", "label": "Published", "default": 0, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "published_at", "fieldtype": "Datetime", "label": "Published At", "in_list_view": 1},
  {"fieldname": "featured", "fieldtype": "Check", "label": "Featured (Homepage)", "default": 0, "in_standard_filter": 1},
  {"fieldname": "sb_content", "fieldtype": "Section Break", "label": "Content"},
  {"fieldname": "excerpt", "fieldtype": "Small Text", "label": "Excerpt", "length": 500},
  {"fieldname": "content", "fieldtype": "Text Editor", "label": "Content"},
  {"fieldname": "sb_media", "fieldtype": "Section Break", "label": "Media"},
  {"fieldname": "featured_image", "fieldtype": "Attach Image", "label": "Featured Image"},
  {"fieldname": "image_caption", "fieldtype": "Data", "label": "Image Caption"},
  {"fieldname": "sb_classification", "fieldtype": "Section Break", "label": "Classification"},
  {"fieldname": "tags", "fieldtype": "Data", "label": "Tags", "description": "Comma-separated"},
  {"fieldname": "language", "fieldtype": "Select", "label": "Language", "options": "it\nro\nen", "default": "it"},
  {"fieldname": "country_focus", "fieldtype": "Data", "label": "Country Focus"},
  {"fieldname": "cb_class1", "fieldtype": "Column Break"},
  {"fieldname": "related_sector", "fieldtype": "Data", "label": "Related Sector",
   "description": "e.g. Banking, Crypto, Real Estate, Procurement..."},
  {"fieldname": "related_case", "fieldtype": "Link", "label": "Related Case (anonymized)", "options": "Investigation Case",
   "description": "Use ONLY anonymized case references in content."},
  {"fieldname": "sb_source", "fieldtype": "Section Break", "label": "Source"},
  {"fieldname": "source_type", "fieldtype": "Select", "label": "Source Type",
   "options": "Internal\nRSS Ingestion\nAI Generated\nExternal Curated", "default": "Internal"},
  {"fieldname": "source", "fieldtype": "Link", "label": "News Source", "options": "News Source"},
  {"fieldname": "source_url", "fieldtype": "Data", "label": "Original URL"},
  {"fieldname": "source_name_label", "fieldtype": "Data", "label": "Source Display Name"},
  {"fieldname": "external_published_at", "fieldtype": "Datetime", "label": "Original Pub Date"},
  {"fieldname": "external_id", "fieldtype": "Data", "label": "External ID (dedup)",
   "description": "Hash of url+guid for dedup"},
  {"fieldname": "sb_stats", "fieldtype": "Section Break", "label": "Stats"},
  {"fieldname": "author", "fieldtype": "Link", "label": "Author", "options": "User"},
  {"fieldname": "reading_time_min", "fieldtype": "Int", "label": "Reading Time (min)", "default": 0},
  {"fieldname": "cb_stats1", "fieldtype": "Column Break"},
  {"fieldname": "views", "fieldtype": "Int", "label": "Views", "default": 0, "read_only": 1},
  {"fieldname": "shares", "fieldtype": "Int", "label": "Shares", "default": 0, "read_only": 1},
  {"fieldname": "sb_seo", "fieldtype": "Section Break", "label": "SEO", "collapsible": 1},
  {"fieldname": "meta_title", "fieldtype": "Data", "label": "Meta Title"},
  {"fieldname": "meta_description", "fieldtype": "Small Text", "label": "Meta Description"},
  {"fieldname": "route", "fieldtype": "Data", "label": "Web Route", "read_only": 1, "hidden": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 0},
  {"role": "Investigation Manager", "read": 1, "write": 1, "create": 1},
  {"role": "Guest", "read": 1, "if_owner": 0}
 ]
}
