 "fields": [
  {
   "fieldname": "sb_main",
   "fieldtype": "Section Break",
   "label": "Investigator"
  },
  {
   "fieldname": "full_name",
   "fieldtype": "Data",
   "label": "Full Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "codename",
   "fieldtype": "Data",
   "label": "Codename (esterno)",
   "unique": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
