  },
  {
   "fieldname": "investigator_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "Employee\nContractor\nAffiliate",
   "default": "Employee",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "availability",
   "fieldtype": "Select",
   "label": "Availability",
   "options": "Available\nBusy\nUnavailable\nOn Leave",
   "default": "Available",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "cb_main",
