{
  "doctype": "DocType",
  "name": "Service Blueprint",
  "module": "Thanatos Core",
  "naming_rule": "By fieldname",
  "autoname": "field:blueprint_name",
  "title_field": "blueprint_name",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "blueprint_name",
      "fieldtype": "Data",
      "label": "Nome blueprint",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "case_type",
      "fieldtype": "Link",
      "label": "Case Type",
      "options": "Case Type",
      "in_list_view": 1
    },
    {
      "fieldname": "category",
      "fieldtype": "Data",
      "label": "Categoria",
      "in_list_view": 1
    },
    {
      "fieldname": "self_serve",
      "fieldtype": "Check",
      "label": "Self-service",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "identity_tier",
      "fieldtype": "Select",
      "label": "Identità minima",
      "options": "Base\nKYC\nKYB\nKIT",
      "default": "Base",
      "in_list_view": 1
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Attivo",
      "default": "1"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Descrizione"
    },
    {
      "fieldname": "sb_steps",
      "fieldtype": "Section Break",
      "label": "Step"
    },
    {
      "fieldname": "steps",
      "fieldtype": "Table",
      "label": "Step",
      "options": "Blueprint Step"
    }
  ],
  "permissions": [
    {
      "role": "Investigation Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "Investigator",
      "read": 1
    }
  ]
}