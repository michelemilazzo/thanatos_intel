{
  "doctype": "DocType",
  "name": "Call Log",
  "module": "Thanatos Core",
  "autoname": "format:CALL-{YYYY}-{#####}",
  "naming_rule": "Expression",
  "title_field": "caller_name",
  "search_fields": "caller_name,caller_number,linked_case,linked_client",
  "sort_field": "called_at",
  "sort_order": "DESC",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "called_at",
      "fieldtype": "Datetime",
      "label": "Data/ora chiamata",
      "reqd": 1,
      "default": "now",
      "in_list_view": 1
    },
    {
      "fieldname": "direction",
      "fieldtype": "Select",
      "label": "Direzione",
      "options": "Entrante\nUscente",
      "default": "Entrante",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "outcome",
      "fieldtype": "Select",
      "label": "Esito",
      "options": "Risposta\nNon risposto\nOccupato\nMessaggio vocale\nRichiamato\nAnnullato",
      "default": "Risposta",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "handled_by",
      "fieldtype": "Link",
      "label": "Gestita da",
      "options": "User",
      "default": "__user",
      "in_list_view": 1
    },
    {
      "fieldname": "sb_caller",
      "fieldtype": "Section Break",
      "label": "Interlocutore"
    },
    {
      "fieldname": "caller_name",
      "fieldtype": "Data",
      "label": "Nome",
      "in_list_view": 1
    },
    {
      "fieldname": "caller_number",
      "fieldtype": "Data",
      "label": "Numero"
    },
    {
      "fieldname": "cb_caller",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "linked_contact",
      "fieldtype": "Link",
      "label": "Contatto rubrica",
      "options": "Intelligence Contact"
    },
    {
      "fieldname": "linked_client",
      "fieldtype": "Link",
      "label": "Cliente",
      "options": "Investigation Client"
    },
    {
      "fieldname": "sb_duration",
      "fieldtype": "Section Break",
      "label": "Durata & Registrazione"
    },
    {
      "fieldname": "duration_minutes",
      "fieldtype": "Int",
      "label": "Durata (minuti)"
    },
    {
      "fieldname": "duration_seconds",
      "fieldtype": "Int",
      "label": "Secondi"
    },
    {
      "fieldname": "cb_duration",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "recording_url",
      "fieldtype": "Data",
      "label": "URL registrazione (opzionale)"
    },
    {
      "fieldname": "sb_links",
      "fieldtype": "Section Break",
      "label": "Collegamenti"
    },
    {
      "fieldname": "linked_case",
      "fieldtype": "Link",
      "label": "Pratica",
      "options": "Investigation Case",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "linked_intel_lead",
      "fieldtype": "Link",
      "label": "Intel Lead",
      "options": "Intel Lead"
    },
    {
      "fieldname": "linked_appointment",
      "fieldtype": "Link",
      "label": "Appuntamento",
      "options": "Investigation Appointment"
    },
    {
      "fieldname": "sb_content",
      "fieldtype": "Section Break",
      "label": "Contenuto"
    },
    {
      "fieldname": "summary",
      "fieldtype": "Text Editor",
      "label": "Riassunto chiamata"
    },
    {
      "fieldname": "action_items",
      "fieldtype": "Text Editor",
      "label": "Azioni da fare (follow-up)"
    },
    {
      "fieldname": "sb_transcript",
      "fieldtype": "Section Break",
      "label": "Trascrizione"
    },
    {
      "fieldname": "audio_file",
      "fieldtype": "Attach",
      "label": "File audio (mp3/mp4/wav/m4a/ogg)"
    },
    {
      "fieldname": "transcription_status",
      "fieldtype": "Select",
      "label": "Stato trascrizione",
      "options": "Non elaborato\nIn elaborazione\nCompletato\nErrore",
      "default": "Non elaborato",
      "read_only": 1,
      "in_list_view": 0
    },
    {
      "fieldname": "transcription_job_id",
      "fieldtype": "Data",
      "label": "Job ID trascrizione",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "speaker_a_label",
      "fieldtype": "Data",
      "label": "Speaker A = ",
      "default": "Operatore",
      "depends_on": "eval:doc.transcription_status=='Completato'"
    },
    {
      "fieldname": "speaker_b_label",
      "fieldtype": "Data",
      "label": "Speaker B = ",
      "depends_on": "eval:doc.transcription_status=='Completato'"
    },
    {
      "fieldname": "transcript_html",
      "fieldtype": "HTML",
      "label": "Trascrizione con voci",
      "depends_on": "eval:doc.transcription_status=='Completato'"
    },
    {
      "fieldname": "transcript_raw",
      "fieldtype": "Long Text",
      "label": "Trascrizione grezza (JSON)",
      "hidden": 1,
      "read_only": 1
    },
    {
      "fieldname": "speaker_embeddings",
      "fieldtype": "Long Text",
      "label": "Impronte vocali (JSON)",
      "hidden": 1,
      "read_only": 1
    },
    {
      "fieldname": "transcript_text",
      "fieldtype": "Text Editor",
      "label": "Testo completo trascrizione",
      "read_only": 1,
      "depends_on": "eval:doc.transcription_status=='Completato'"
    }
  ],
  "permissions": [
    {
      "role": "Investigation Manager",
      "read": 1, "write": 1, "create": 1, "delete": 1,
      "report": 1, "export": 1, "print": 1, "email": 1, "share": 1
    },
    {
      "role": "Investigator",
      "read": 1, "write": 1, "create": 1, "report": 1, "print": 1
    },
    {
      "role": "Lawyer",
      "read": 1, "write": 1, "create": 1
    }
  ]
}
