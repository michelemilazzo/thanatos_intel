{
  "doctype": "DocType",
  "name": "OSINT Lookup",
  "module": "Osint",
  "track_changes": 0,
  "autoname": "format:OSINT-{YYYY}-{#####}",
  "title_field": "target_value",
  "fields": [
    {"fieldname": "target_type", "fieldtype": "Select", "label": "Target Type", "options": "Email\nIP\nDomain\nUrl\nHash\nCompany\nPhone\nUsername\nWallet\nFile", "reqd": 1, "in_list_view": 1},
    {"fieldname": "target_value", "fieldtype": "Data", "label": "Target", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "source", "fieldtype": "Data", "label": "Source", "in_list_view": 1},
    {"fieldname": "col_1", "fieldtype": "Column Break"},
    {"fieldname": "performed_at", "fieldtype": "Datetime", "label": "Performed At", "in_list_view": 1},
    {"fieldname": "performed_by", "fieldtype": "Link", "label": "Performed By", "options": "User"},
    {"fieldname": "is_stub", "fieldtype": "Check", "label": "Stub (no API key)"},
    {"fieldname": "is_error", "fieldtype": "Check", "label": "Error"},
    {"fieldname": "sb_result", "fieldtype": "Section Break", "label": "Result"},
    {"fieldname": "result_json", "fieldtype": "Code", "label": "Result JSON", "options": "JSON"},
    {"fieldname": "sb_link", "fieldtype": "Section Break", "label": "Linked"},
    {"fieldname": "investigation_case", "fieldtype": "Link", "label": "Investigation Case", "options": "Investigation Case"},
    {"fieldname": "investigation_entity", "fieldtype": "Link", "label": "Investigation Entity", "options": "Investigation Entity"}
  ],
  "permissions": [
    {"role": "Investigation Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Investigator", "read": 1, "write": 1, "create": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
