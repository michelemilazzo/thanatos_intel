{
  "doctype": "DocType",
  "name": "Due Diligence Report",
  "module": "Thanatos Corporate",
  "autoname": "format:DDR-{YYYY}-{#####}",
  "title_field": "title",
  "fields": [
    {"fieldname": "title", "fieldtype": "Data", "label": "Title", "reqd": 1, "in_list_view": 1},
    {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company Profile", "in_list_view": 1},
    {"fieldname": "client", "fieldtype": "Link", "label": "Client", "options": "Investigation Client", "in_standard_filter": 1},
    {"fieldname": "investigation_case", "fieldtype": "Link", "label": "Case", "options": "Investigation Case"},
    {"fieldname": "col_1", "fieldtype": "Column Break"},
    {"fieldname": "level", "fieldtype": "Select", "label": "Level", "options": "Light\nStandard\nFull\nEnhanced", "default": "Standard", "in_list_view": 1},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nIn Review\nCompleted\nSigned", "default": "Draft", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "issued_on", "fieldtype": "Date", "label": "Issued On", "in_list_view": 1},
    {"fieldname": "expires_on", "fieldtype": "Date", "label": "Expires On"},
    {"fieldname": "sb_findings", "fieldtype": "Section Break", "label": "Findings"},
    {"fieldname": "summary", "fieldtype": "Text Editor", "label": "Executive Summary"},
    {"fieldname": "corporate_findings", "fieldtype": "Text Editor", "label": "Corporate"},
    {"fieldname": "financial_findings", "fieldtype": "Text Editor", "label": "Financial"},
    {"fieldname": "reputational_findings", "fieldtype": "Text Editor", "label": "Reputational"},
    {"fieldname": "compliance_findings", "fieldtype": "Text Editor", "label": "Compliance / Sanctions / PEP"},
    {"fieldname": "litigation_findings", "fieldtype": "Text Editor", "label": "Litigation / Insolvency"},
    {"fieldname": "sb_risk", "fieldtype": "Section Break", "label": "Risk Verdict"},
    {"fieldname": "overall_verdict", "fieldtype": "Select", "label": "Verdict", "options": "\nGreen\nYellow\nRed", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "risk_score", "fieldtype": "Int", "label": "Risk Score", "in_list_view": 1},
    {"fieldname": "col_risk", "fieldtype": "Column Break"},
    {"fieldname": "recommendation", "fieldtype": "Small Text", "label": "Recommendation"},
    {"fieldname": "analyst", "fieldtype": "Link", "label": "Analyst", "options": "User"},
    {"fieldname": "reviewer", "fieldtype": "Link", "label": "Reviewer", "options": "User"},
    {"fieldname": "sb_pdf", "fieldtype": "Section Break", "label": "PDF"},
    {"fieldname": "pdf_file", "fieldtype": "Attach", "label": "PDF"},
    {"fieldname": "pdf_sha256", "fieldtype": "Data", "label": "PDF SHA-256"}
  ],
  "permissions": [
    {"role": "Investigation Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Investigator", "read": 1, "write": 1, "create": 1},
    {"role": "Accountant", "read": 1, "write": 1, "create": 1},
    {"role": "Lawyer", "read": 1},
    {"role": "Investigation Client", "read": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ]
}
