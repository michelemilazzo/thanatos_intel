    {"fieldname": "risk_level", "fieldtype": "Select", "label": "Risk Level", "options": "Low\nMedium\nHigh\nCritical", "default": "Medium", "in_list_view": 1},
    {"fieldname": "pep_screening", "fieldtype": "Check", "label": "PEP Screening"},
    {"fieldname": "sanctions_screening", "fieldtype": "Check", "label": "Sanctions Screening"},
    {"fieldname": "adverse_media", "fieldtype": "Check", "label": "Adverse Media"},
    {"fieldname": "source_of_funds", "fieldtype": "Check", "label": "Source Of Funds"},
    {"fieldname": "source_of_wealth", "fieldtype": "Check", "label": "Source Of Wealth"},
    {"fieldname": "comments", "fieldtype": "Text Editor", "label": "Comments"}
